---
import '@/styles/themes.css';
import { url } from '@/lib/paths';

interface Props {
  title?: string;
}

const { title = 'Navi' } = Astro.props;

// Gli asset statici seguono il base path (radice in dev, /navi/ su Pages).
// `url()` normalizza la barra: `BASE_URL` arriva senza quella finale.
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no"
    />
    <meta name="description" content="Tachimetro GPS, velocità media tra varchi Tutor e storico viaggi. Offline-first." />
    <meta name="theme-color" content="#0b1220" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icons/icon-192.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { registerSW } from 'virtual:pwa-register';

      registerSW({ immediate: true });
    </script>
  </body>
</html>

<style is:global>
  /* Reset di base; i token colore/font vivono in src/styles/themes.css. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    height: 100%;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
    /* Rispetta notch e barre di sistema quando installata in standalone. */
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
    overscroll-behavior: none;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
