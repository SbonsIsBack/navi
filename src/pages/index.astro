---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Navi">
  <main>
    <svg viewBox="0 0 64 64" width="96" height="96" aria-hidden="true">
      <path
        d="M 13.6 45.4 A 23 23 0 1 1 50.4 45.4"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="6"
        stroke-linecap="round"></path>
      <line
        x1="32"
        y1="32"
        x2="46"
        y2="18"
        stroke="var(--color-text)"
        stroke-width="4.5"
        stroke-linecap="round"></line>
      <circle cx="32" cy="32" r="4.5" fill="var(--color-accent)"></circle>
    </svg>
    <h1>Navi</h1>
    <p>Tutor &amp; Average Speed Tracker</p>
    <p class="note">
      PWA installabile e offline-first.<br />Il tachimetro arriva con la Fase 2.
    </p>
  </main>
</Layout>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1rem;
  }

  h1 {
    font-size: 2.5rem;
    letter-spacing: 0.08em;
  }

  p {
    color: var(--color-text-dim);
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
  }
</style>
