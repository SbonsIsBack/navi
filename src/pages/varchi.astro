---
import Layout from '@/layouts/Layout.astro';
import GatesPage from '@/components/gates/GatesPage';
---

<Layout title="Varchi Tutor — Navi">
  <GatesPage client:only="preact" />
</Layout>

<script is:inline>
  try {
    var t = localStorage.getItem('navi:theme');
    if (t === 'analog' || t === 'digital' || t === 'retro') {
      document.documentElement.dataset.theme = t;
    }
  } catch (e) {}
</script>
